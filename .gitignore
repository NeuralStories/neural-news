# Entregas, paquetes y fuentes recuperadas: nunca en el árbol versionado.
# Se sellan en storage/_entregas/ con manifiesto SHA-256 (backups/MANIFIESTO_SELLADO_*.txt).
*.zip
*.rar
*.7z
flow-recovery/
*ENTREGA_UNICA*/

# Herramientas locales del workspace (viven fuera de este repositorio).
ffmpeg-local/
pglocal/
tools/*.exe
tools/dbg*
tools/*.rar
tools/*.zip
archive/
backups/
.remotes/

# Logs de la pila en marcha (los escribe `scripts/start.ps1` y Playwright).
_*.log
_*.err.log
apps/api/_*.log
apps/web/_*.log
test-results/
playwright-report/

# Marcadores de runtime del supervisor externo (`supervisor.sh`): son estado de
# la máquina, no del repositorio. `docs/agente/TERMINADO` evita que el
# supervisor relancee el agente; bórralo para retomar el trabajo pendiente.
docs/agente/TERMINADO
docs/agente/espera.txt

# docs/gobernanza (DEC-01): la gobernanza SÍ se versiona, pero nunca sus
# artefactos generados. Si alguien deja un node_modules, una base local o un
# .env dentro, no deben acabar en el repositorio.
docs/gobernanza/**/node_modules/
docs/gobernanza/**/*.db
docs/gobernanza/**/*.sqlite
docs/gobernanza/**/.env
docs/gobernanza/**/.next/
docs/gobernanza/**/__pycache__/
docs/gobernanza/**/.pytest_cache/
