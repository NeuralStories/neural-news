FROM python:3.12-slim

WORKDIR /opt/app

COPY apps/api/pyproject.toml apps/api/README.md* /opt/app/apps/api/
COPY apps/api/src /opt/app/apps/api/src
COPY infra/migrations /opt/app/infra/migrations

RUN pip install --no-cache-dir "psycopg[binary]" /opt/app/apps/api

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "neuralnews.main:app", "--host", "0.0.0.0", "--port", "8000"]
