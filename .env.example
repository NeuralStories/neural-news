# neural.news — ejemplo de configuración. Copia a .env y ajusta.
# NUNCA guardes claves reales en el repositorio.
#
# Todas las variables que lee el código están aquí: `tests/test_env_example_completo.py`
# falla si el backend añade una variable y esta plantilla no la recoge.

# --- Modo de funcionamiento -------------------------------------------------
# true = demo reproducible sin claves; los servicios de pago quedan bloqueados.
NEURAL_DEMO_MODE=true

# --- Entorno de despliegue ----------------------------------------------------
# local = instalación de escritorio (el proxy same-origin puede apuntar a
#          127.0.0.1:8000). beta|prod = instalación real: NEURAL_API_URL es
#          OBLIGATORIA y el build de la web FALLA si falta (hallazgo B9).
NEURAL_ENV=local
# Destino del proxy same-origin /api/* (solo si la web no está en el mismo
# servidor que la API):
# NEURAL_API_URL=https://api.neural.news

# --- Identidad de la aplicación ----------------------------------------------
NEURAL_APP_NAME=neural.news

# --- Registro (servidor) ------------------------------------------------------
# INFO por defecto. Los errores del servidor se registran aquí en vez de
# devolverse al cliente (hallazgo B7) o perderse por stderr (hallazgo P5).
NEURAL_LOG_LEVEL=INFO

# --- Base de datos -----------------------------------------------------------
# Por defecto (desarrollo local sin Docker): SQLite en storage/
# NEURAL_DATABASE_URL=sqlite:///C:/ruta/proyecto final/storage/neural-news.db
# Con docker compose (PostgreSQL):
# NEURAL_DATABASE_URL=postgresql+psycopg://neural:neural-local@localhost:5432/neuralnews

# --- Acceso del editor -------------------------------------------------------
NEURAL_ADMIN_USERNAME=editor
NEURAL_ADMIN_PASSWORD=neural-demo

# --- Sesión ------------------------------------------------------------------
# Duración de la sesión de editor, en minutos (por defecto 720 = 12 h).
# NEURAL_SESSION_TTL_MINUTES=720
# Orígenes CORS permitidos (lista JSON):
# NEURAL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Cookie de sesión: por defecto «segura» fuera de local (ADR-017).
# NEURAL_SESSION_COOKIE_SECURE=false
# NEURAL_SESSION_COOKIE_SAMESITE=lax
# NEURAL_SESSION_COOKIE_DOMAIN=

# --- Red (conector web/RSS) ---------------------------------------------------
# Tamaño máximo de una descarga (bytes) y tiempo de espera (s).
# NEURAL_MAX_DOWNLOAD_BYTES=5242880
# NEURAL_FETCH_TIMEOUT_S=20
# NEURAL_FETCH_MAX_REDIRECTS=3
# Esquemas permitidos en las descargas:
# NEURAL_ALLOWED_URL_SCHEMES=["http","https"]
# Hosts bloqueados siempre (lista JSON):
# NEURAL_BLOCKED_HOSTS=[]
# Hosts de confianza explícitos (p. ej. servidor de pruebas local); con cuidado.
NEURAL_ALLOWED_HOSTS=[]

# --- Trabajos (cola) ----------------------------------------------------------
# Duración del lease (s) y reintentos por trabajo.
# NEURAL_JOB_LEASE_SECONDS=300
# NEURAL_JOB_MAX_ATTEMPTS=3

# --- Costes: empiezan desactivados -------------------------------------------
NEURAL_PAID_SERVICES_ENABLED=false
NEURAL_BUDGET_DAILY_EUR=0

# --- Claves de proveedores (opcional; vacío = adaptador no usable) ----------
# YouTube Data API v3 (metadatos de vídeo)
NEURAL_YOUTUBE_API_KEY=
# Gemini (análisis de vídeo por URL pública de YouTube)
NEURAL_GEMINI_API_KEY=
# Spotify Web API (token de USUARIO; get-an-episode lo requiere)
NEURAL_SPOTIFY_ACCESS_TOKEN=
# Modelo editorial compatible OpenAI (extracción y guiones reales)
NEURAL_LLM_API_KEY=
NEURAL_LLM_BASE_URL=https://api.openai.com/v1
NEURAL_LLM_MODEL=gpt-4o-mini
# Búsqueda para investigación (adaptador Brave preparado)
NEURAL_SEARCH_API_KEY=
# NEURAL_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# --- Bóveda de secretos (NN-117.3) -------------------------------------------
# Clave maestra Fernet (urlsafe-b64 de 32 bytes). Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin ella, las claves de proveedor se pueden guardar en .env pero **no** cifradas
# en la base de datos.
# NEURAL_MASTER_KEY=
