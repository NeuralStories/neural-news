  "components": {
    "schemas": {
      "ApproveRequest": {
        "properties": {
          "script_version_id": {
            "type": "integer",
            "title": "Script Version Id"
          }
        },
        "type": "object",
        "required": [
          "script_version_id"
        ],
        "title": "ApproveRequest"
      },
      "BatchCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": ""
          },
          "target_size": {
            "type": "integer",
            "enum": [
              5,
              10
            ],
            "title": "Target Size"
          },
          "story_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Story Ids"
          }
        },
        "type": "object",
        "required": [
          "target_size",
          "story_ids"
        ],
        "title": "BatchCreate"
      },
      "BudgetUpdate": {
        "properties": {
          "paid_services_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paid Services Enabled"
          },
          "daily_limit_eur": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Limit Eur"
          }
        },
        "type": "object",
        "title": "BudgetUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "default": ""
          },
          "password": {
            "type": "string",
            "title": "Password",
            "default": ""
          }
        },
        "type": "object",
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo"
          },
          "demo_mode": {
            "type": "boolean",
            "title": "Demo Mode"
          }
        },
        "type": "object",
        "required": [
          "actor_id",
          "is_demo",
          "demo_mode"
        ],
        "title": "MeResponse"
      },
      "ProcessRequest": {
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "title": "ProcessRequest"
      },
      "RejectRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "title": "RejectRequest"
      },
      "ScriptPatch": {
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
          "content",
          "expected_version"
        ],
        "title": "ScriptPatch"
      },
      "SourceCreate": {
        "properties": {
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "transcript": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript"
          }
        },
        "type": "object",
        "title": "SourceCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}