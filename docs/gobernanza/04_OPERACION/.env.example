# EJEMPLO — nunca añadir secretos reales al repositorio.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://neural:CHANGE_IN_LOCAL_SECRET_MANAGER@postgres:5432/neural
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
MEDIA_STORAGE_ROOT=/var/lib/neural-news/media
APP_MASTER_KEY=REQUIRED_FROM_EXTERNAL_SECRET_STORE
SESSION_SECRET=REQUIRED_FROM_EXTERNAL_SECRET_STORE
DEFAULT_BUDGET_CEILING=0
DEFAULT_PAID_ALLOWED=false
LOG_LEVEL=INFO
# Conexiones de proveedores: se administran en la base de datos desde el panel.
# No añadir GOOGLE_API_KEY, OPENAI_API_KEY o claves de producción aquí en Git.
