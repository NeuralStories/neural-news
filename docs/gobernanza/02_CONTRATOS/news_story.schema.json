{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "news_story",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "story_id",
    "kind",
    "title",
    "locale",
    "status",
    "sources",
    "claims",
    "evidence",
    "revision_hash"
  ],
  "properties": {
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "DEMO",
        "REAL"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "enum": [
        "es-ES",
        "en-US"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "CAPTURED",
        "REVIEW_REQUIRED",
        "EDITORIAL_APPROVED",
        "BLOCKED"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "snapshot_id",
          "url",
          "fetched_at",
          "sha256",
          "independence_group"
        ],
        "additionalProperties": false,
        "properties": {
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "independence_group": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "verification_status",
          "evidence_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "UNVERIFIED",
              "SUPPORTED",
              "DISPUTED",
              "REJECTED"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewed_by": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "snapshot_id",
          "quote",
          "position"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "revision_hash": {
      "type": "string",
      "minLength": 1
    }
  }
}
