{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "flow-sdk": [
        "./src/flow-sdk/index.ts"
      ]
    },
    "baseUrl": ".",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "tests"
  ]
}
